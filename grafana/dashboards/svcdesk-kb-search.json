{
  "uid": "svcdesk-kb-search",
  "title": "svcdesk - /kb/search SLO",
  "tags": ["svcdesk", "lab3"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "/kb/search latency: p50, p95, p99 (from the histogram)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "p99",
         "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\", http_route=\"/kb/search\"}[$__rate_interval])))"},
        {"refId": "B", "legendFormat": "p95",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\", http_route=\"/kb/search\"}[$__rate_interval])))"},
        {"refId": "C", "legendFormat": "p50",
         "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\", http_route=\"/kb/search\"}[$__rate_interval])))"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "/kb/search requests per second, by status",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "{{http_response_status_code}}",
         "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\"}[$__rate_interval]))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Availability SLI: share of /kb/search answered without a 5xx (objective 0.99)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.9, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "good / valid (5m)",
         "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\", http_response_status_code!~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\"}[5m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency SLI: share of /kb/search within 0.3 s (objective 0.99)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0.9, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "<= 0.3 s / all (5m)",
         "expr": "sum(rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\", http_route=\"/kb/search\", le=\"0.3\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\"}[5m]))"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Availability burn rate (1h and 5m windows; page at 14.4)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "targets": [
        {"refId": "A", "legendFormat": "burn rate 1h",
         "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\", http_response_status_code=~\"5..\"}[1h])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\"}[1h])) / (1 - 0.99)"},
        {"refId": "B", "legendFormat": "burn rate 5m",
         "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\", http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\", http_route=\"/kb/search\"}[5m])) / (1 - 0.99)"}
      ]
    }
  ]
}
